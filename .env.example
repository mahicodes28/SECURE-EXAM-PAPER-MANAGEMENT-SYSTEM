# Flask Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production-use-32-random-bytes
WTF_CSRF_SECRET_KEY=your-csrf-secret-here-change-in-production

# Database
DATABASE_URL=sqlite:///exam_system.db

# Blockchain Configuration
GANACHE_URL=http://127.0.0.1:7545
CONTRACT_ADDRESS=your-deployed-contract-address-here
ADMIN_WALLET_ADDRESS=your-admin-wallet-address-here
# NEVER commit your private key — use environment variable only
ADMIN_PRIVATE_KEY=your-admin-private-key-here

# Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=your-fernet-key-here-generate-with-cryptography-library

# File Storage
UPLOAD_FOLDER=encrypted_storage
MAX_CONTENT_LENGTH=16777216

# Admin Default Account (change immediately after first login)
ADMIN_EMAIL=admin@university.edu
ADMIN_PASSWORD=ChangeMe@2024!
